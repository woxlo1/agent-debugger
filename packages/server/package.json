{
  "name": "agent-debugger-server",
  "version": "1.0.2",
  "description": "Local replay debugger and rule-based Cause Package server for agent traces.",
  "type": "module",
  "bin": {
    "agent-debugger": "bin/cli.js"
  },
  "files": ["bin", "dist"],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woxlo1/agent-debugger.git"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/packages/server/src/index.js",
    "prepack": "npm run build",
    "pipe": "node bin/cli.js pipe"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^7.0.4"
  },
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
